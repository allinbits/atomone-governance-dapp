{
  "name": "@eclesia/atomone-governance",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "queries": "npx graphql-code-generator -c codegen.ts",
    "build": "vue-tsc && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test:e2e:serve": "serve -s dist -l 8080",
    "test:e2e": "npx playwright install && playwright test",
    "test:components": "npx playwright install && playwright test -c playwright-ct.config.ts",
    "test:components:debug": "npx playwright install && playwright test -c playwright-ct.config.ts --debug",
    "test:unit": "vitest run --reporter=verbose",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agoose77/markdown-it-mermaid": "^1.1.0",
    "@apollo/client": "^3.14.1",
    "@cosmjs/proto-signing": "^0.38.1",
    "@cosmjs/stargate": "^0.38.1",
    "@cosmostation/cosmos-client": "^0.0.5",
    "@giscus/vue": "^3.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@keplr-wallet/types": "^0.13.41",
    "@tanstack/vue-query": "^5.104.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vue/apollo-composable": "^4.2.2",
    "@vueuse/core": "^14.4.0",
    "@wdns/vue-code-block": "^2.3.5",
    "chart.js": "^4.5.1",
    "chartjs-chart-treemap": "^3.1.0",
    "cosmjs-types": "^0.11.0",
    "dayjs": "^1.11.23",
    "dompurify": "3.4.16",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.7",
    "markdown-it": "^14.3.2",
    "markdown-it-github-alert": "^1.0.6",
    "markdown-it-katex": "^2.0.3",
    "mitt": "^3.0.1",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@atomone/atomone-types": "^1.0.3",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@graphql-codegen/typescript-vue-apollo": "^5.0.1",
    "@playwright/experimental-ct-vue": "1.62.1",
    "@playwright/test": "1.62.1",
    "@rollup/plugin-graphql": "^2.0.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^25.9.8",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.11",
    "@vue/compiler-dom": "^3.5.43",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "bignumber.js": "^10.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.5",
    "mermaid": "^11.17.2",
    "mobx": "^6.16.1",
    "mobx-vue-lite": "^0.4.3",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
