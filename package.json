{
  "name": "@eclesia/atomone-governance",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.17.0"
  },
  "scripts": {
    "dev": "vite",
    "queries": "npx graphql-code-generator -c codegen.ts",
    "build": "vue-tsc && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test:e2e:serve": "serve -s dist -l 8080",
    "test:e2e": "npx playwright install && playwright test",
    "test:components": "npx playwright install && playwright test -c playwright-ct.config.ts",
    "test:components:debug": "npx playwright install && playwright test -c playwright-ct.config.ts --debug",
    "test:unit": "vitest run --reporter=verbose",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agoose77/markdown-it-mermaid": "^1.1.0",
    "@apollo/client": "^3.13.8",
    "@cosmjs/proto-signing": "^0.38.1",
    "@cosmjs/stargate": "^0.38.1",
    "@cosmostation/cosmos-client": "^0.0.5",
    "@giscus/vue": "^3.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@keplr-wallet/types": "^0.13.20",
    "@tanstack/vue-query": "^5.97.0",
    "@vitest/coverage-istanbul": "^4.1.4",
    "@vue/apollo-composable": "^4.2.2",
    "@vueuse/core": "^14.2.1",
    "@wdns/vue-code-block": "^2.3.5",
    "chart.js": "^4.5.1",
    "chartjs-chart-treemap": "^3.1.0",
    "cosmjs-types": "^0.11.0",
    "dayjs": "^1.11.20",
    "dompurify": "3.3.3",
    "graphql": "^16.13.2",
    "graphql-tag": "^2.12.6",
    "markdown-it": "^14.1.1",
    "markdown-it-github-alert": "^1.0.6",
    "markdown-it-katex": "^2.0.3",
    "mitt": "^3.0.1",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vue": "^3.5.32",
    "vue-chartjs": "^5.3.3",
    "vue-i18n": "^11.3.2",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@atomone/atomone-types": "^1.0.3",
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/typescript": "^5.0.9",
    "@graphql-codegen/typescript-operations": "^5.0.9",
    "@graphql-codegen/typescript-vue-apollo": "^5.0.0",
    "@playwright/experimental-ct-vue": "1.59.1",
    "@playwright/test": "1.59.1",
    "@rollup/plugin-graphql": "^2.0.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.5.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/eslint-plugin": "^1.6.15",
    "@vitest/ui": "^4.1.4",
    "@vue/compiler-dom": "^3.5.32",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "bignumber.js": "^10.0.2",
    "dotenv": "^17.4.1",
    "eslint": "^10.2.0",
    "eslint-plugin-playwright": "^2.10.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "happy-dom": "^20.8.9",
    "mermaid": "^11.14.0",
    "mobx": "^6.15.0",
    "mobx-vue-lite": "^0.4.3",
    "serve": "^14.2.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "mermaid": "^11.14.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs",
      "vue-demi"
    ]
  }
}
